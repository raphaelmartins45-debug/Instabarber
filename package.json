{
  "name": "instabarber",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sql": "bash scripts/testar-sql.sh",
    "test:e2e": "playwright test",
    "db:migrate": "supabase db push",
    "db:types": "supabase gen types typescript --local > types/database.ts"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "@supabase/supabase-js": "2.118.0",
    "@supabase/ssr": "0.5.2",
    "@tanstack/react-query": "5.62.11",
    "zustand": "5.0.2",
    "react-hook-form": "7.54.2",
    "@hookform/resolvers": "3.9.1",
    "zod": "3.24.1",
    "recharts": "2.15.0",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "jspdf": "4.2.1",
    "resend": "4.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.0.1",
    "lucide-react": "0.469.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "tailwindcss": "4.0.0",
    "@tailwindcss/postcss": "4.0.0",
    "postcss": "8.5.31",
    "tw-animate-css": "1.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "@eslint/eslintrc": "3.2.0",
    "prettier": "3.4.2",
    "vitest": "5.0.5",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "supabase": "2.121.0"
  },
  "overrides": {
    "postcss": "8.5.31"
  }
}
